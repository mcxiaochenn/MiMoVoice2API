# ===== 上游 MiMo =====

# 必填。MiMo 开放平台 API Key。只从环境变量读取，不要写进镜像或仓库。
MIMO_API_KEY=

# 上游地址。必须包含版本段 /v1；一般不需要改，指向代理或本地测试桩时可覆盖。
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 请求未指定 model 时使用的默认模型。
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TTS_MODEL=mimo-v2.5-tts

# ===== 本服务 =====

# 监听地址。
LISTEN_ADDR=:8080

# 下游 Bearer token。留空 = 不校验，仅限本机调试；启动时会打 WARN。
AUTH_TOKEN=

# 上传音频上限（字节），默认 25 MiB。base64 后体积约为 4/3。
MAX_UPLOAD_BYTES=26214400

# 单次合成文本上限（字符）。超限返回 400 text_too_long。
MAX_TTS_CHARS=1000

# 单次上游请求总超时。
UPSTREAM_TIMEOUT=180s

# 是否暴露 /metrics。关闭后该路径返回 404。
# 开启时 /metrics 与 /v1 一样需要 AUTH_TOKEN（抓取端配置 bearer_token）。
METRICS_ENABLED=true

# debug | info | warn | error
LOG_LEVEL=info

# json | text
LOG_FORMAT=json
